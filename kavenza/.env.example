# Set this to the real public origin before production builds.
# A placeholder value is ignored so it cannot leak into canonical metadata or sitemaps.
SITE_URL=https://YOUR-KAVENZA-DOMAIN.com

# Frontend API origin. Set this to the deployed Flask API URL for production builds.
VITE_CONTACT_API_URL=http://127.0.0.1:5000

# Flask API settings. Use the exact origin serving the frontend.
CONTACT_ALLOWED_ORIGIN=http://127.0.0.1:5173
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_PATH=backend/kavenza.sqlite3
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false
MAIL_BUSINESS_EMAIL=kavenza.kaviya77@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=kavenza.kaviya77@gmail.com
SMTP_PASSWORD=your-gmail-app-password
